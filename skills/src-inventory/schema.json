{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "src-inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["generated", "source_file", "components"],
  "properties": {
    "generated": { "type": "string", "description": "ISO date YYYY-MM-DD" },
    "source_file": { "type": "string", "description": "Input .md file name" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "repo", "status", "java", "spring_boot", "source", "notes"],
        "properties": {
          "component": { "type": "string" },
          "repo": { "type": "string", "description": "group/project path" },
          "status": { "enum": ["ok", "non-maven", "inaccessible"] },
          "java": { "type": ["string", "null"], "description": "Major version, e.g. \"17\", \"21\". null = not found" },
          "spring_boot": { "type": ["string", "null"], "description": "e.g. \"3.2.5\". null = not found" },
          "source": { "type": "array", "items": { "enum": ["pom", "pom (property)", "Dockerfile"] } },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
